{
  "name": "webdyne-d1-sessions-example",
  "private": true,
  "type": "module",
  "scripts": {"check": "webdyne-cloudflare check", "dev": "webdyne-cloudflare dev"},
  "dependencies": {"@webdyne/webdyne-zeroperl": "^1.0.12", "@webdyne/webdyne-cloudflare": "^1.6.0"},
  "webdyne": {
    "entry": "app.pagi", "static": false,
    "extensions": {"@webdyne/webdyne-cloudflare": {"d1Bindings": ["DB"]}},
    "cloudflare": {"name": "webdyne-d1-sessions-example", "d1Databases": [
      {"binding": "DB", "databaseName": "webdyne-d1-sessions-example", "databaseId": "00000000-0000-0000-0000-000000000001"}
    ]}
  }
}
