<api handler="d1_row" pattern="/row/:id" canonical>

__PERL__

use JSON::PP ();
use WebDyne::Cloudflare::D1;

sub d1_row {
    my ($self, $match_hr) = @_;
    my $db = WebDyne::Cloudflare::D1->new(
        scope   => $self->r()->{'scope'},
        binding => 'DB',
    );
    my $row = $db->prepare(
        'SELECT id, name, note, payload FROM webdyne_d1_example WHERE id = ?1 LIMIT 1'
    )->bind($match_hr->{'id'})->first()->get();
    return { found => JSON::PP::false } unless $row;
    return {
        found          => JSON::PP::true,
        id             => $row->{'id'},
        name           => $row->{'name'},
        note           => $row->{'note'},
        payload_length => length($row->{'payload'} // ''),
    };
}
