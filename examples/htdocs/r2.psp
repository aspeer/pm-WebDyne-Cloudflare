<start_html title="WebDyne Cloudflare R2 Smoke" h2>
<perl handler="r2_smoke">
<p>R2 smoke OK: ${action}</p>
</perl>

__PERL__

use WebDyne::Cloudflare::R2;

sub r2_smoke {
    my ($self) = @_;
    my $cgi = $self->CGI();
    my $action = scalar($cgi->param('action')) // '';
    my $key = scalar($cgi->param('key')) // '';
    die "Invalid R2 smoke action\n"
        unless $action =~ /\A(?:put|get|head|list|delete)\z/;
    die "Invalid R2 smoke key\n"
        unless $key =~ /\Awebdyne-smoke\/[a-z0-9-]{8,80}\.bin\z/;

    my $r2 = WebDyne::Cloudflare::R2->new(
        scope   => $self->r()->{'scope'},
        binding => 'OBJECTS',
    );
    my $expected = "\0WebDyne R2\xff";

    if ($action eq 'put') {
        my $stored = $r2->put(
            $key,
            WebDyne::Cloudflare::R2->blob($expected),
            http_metadata => { content_type => 'application/octet-stream' },
            custom_metadata => { suite => 'WebDyne::Cloudflare::R2' },
        )->get();
        die "R2 smoke put returned no object\n" unless $stored && $stored->size() == length($expected);
    }
    elsif ($action eq 'get') {
        my $object = $r2->get($key)->get();
        die "R2 smoke body does not match\n"
            unless $object && defined($object->body()) && $object->body() eq $expected;
        die "R2 smoke metadata does not match\n"
            unless ($object->http_metadata()->{'content_type'} // '') eq 'application/octet-stream'
                && ($object->custom_metadata()->{'suite'} // '') eq 'WebDyne::Cloudflare::R2';
    }
    elsif ($action eq 'head') {
        my $object = $r2->head($key)->get();
        die "R2 smoke head returned no object\n" unless $object && $object->size() == length($expected);
    }
    elsif ($action eq 'list') {
        my $result = $r2->list(
            prefix => $key,
            limit => 10,
            include => ['customMetadata'],
        )->get();
        my $found = grep { $_->key() eq $key } @{$result->{'objects'} // []};
        die "R2 smoke object is not listed\n" unless $found;
    }
    else {
        $r2->delete($key)->get();
    }
    return $self->render(action => $action);
}
