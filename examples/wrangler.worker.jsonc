{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "webdyne-cloudflare-d1-example",
  "main": "../../wasm-WebDyne-PAGI/src/worker.js",
  "compatibility_date": "2026-08-27",
  "vars": {
    "WEBDYNE_INDEX": "d1.psp",
    "WEBDYNE_STATIC": "1",
    "WEBDYNE_D1_BINDINGS": "DB"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webdyne-cloudflare-m2",
      "database_id": "90b2beca-642c-4a54-a3b2-872fbeea5729"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.pl", "**/*.pm"],
      "fallthrough": false
    },
    {
      "type": "Data",
      "globs": ["**/*.tar.gz"],
      "fallthrough": false
    }
  ]
}
