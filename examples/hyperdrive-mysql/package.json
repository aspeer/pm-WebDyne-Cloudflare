{
  "name": "webdyne-hyperdrive-mysql-example",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "webdyne-cloudflare build",
    "check": "webdyne-cloudflare check",
    "dev": "webdyne-cloudflare dev"
  },
  "dependencies": {
    "@webdyne/webdyne-zeroperl": "^1.0.14",
    "@webdyne/webdyne-cloudflare": "^1.7.1"
  },
  "webdyne": {
    "entry": "app.psp",
    "static": false,
    "extensions": {
      "@webdyne/webdyne-cloudflare": {
        "hyperdriveBindings": [
          "DB"
        ]
      }
    },
    "cloudflare": {
      "hyperdrive": [
        {
          "binding": "DB",
          "id": "REPLACE_WITH_YOUR_32_HEX_HYPERDRIVE_ID"
        }
      ]
    }
  }
}
