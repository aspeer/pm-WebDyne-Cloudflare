use strict;
use warnings;
use Future::AsyncAwait;
use JSON::PP ();
use WebDyne::Cloudflare::Hyperdrive;

async sub {
    my ($scope_hr, $receive_cr, $send_cr)=@_;
    return if $scope_hr->{'type'} eq 'lifespan';
    my $db_or=WebDyne::Cloudflare::Hyperdrive->new(scope => $scope_hr);
    my $token=$db_or->{'runToken'};
    if ($scope_hr->{'path'} eq '/abort') {
        die "missing abort test token\n" unless $scope_hr->{'query_string'}=~/\Atoken=([a-f0-9-]{36})\z/;
        $token=$1;
    }
    my $unicode="O'Brien \x{2014} caf\x{e9} \x{65e5}\x{672c}\x{8a9e} \x{1f42a}";
    my $result_hr=await $db_or->query(
        'SELECT $1::text, $2::bigint, $3::bytea, $4::text, $5::numeric',
        $unicode, '9007199254740993', $db_or->bytes("\x00\xff\x80A"), undef,
        '12345678901234567890.1234567890',
    );
    my $row_ar=$result_hr->{'rows'}[0];
    die "typed bound round-trip failed\n" unless (($row_ar->[0] eq $unicode)
        &&($row_ar->[1] eq '9007199254740993')
        &&(unpack('H*', $row_ar->[2]) eq '00ff8041')&&!defined($row_ar->[3])
        &&($row_ar->[4] eq '12345678901234567890.1234567890'));

    my $fixture_hr=await $db_or->query(
        'SELECT large_integer, amount, payload FROM webdyne_hyperdrive_test.samples WHERE id=$1', 2,
    );
    die "fixture mismatch\n" unless (($fixture_hr->{'rows'}[0][0] eq '9007199254740993')
        &&(unpack('H*', $fixture_hr->{'rows'}[0][2]) eq '00ff00414243'));

    #  Deliberately leave the last transaction open: host lifecycle must roll it
    #  back and close the connection even when Perl does not disconnect explicitly.
    #
    await $db_or->query('BEGIN');
    await $db_or->query('INSERT INTO webdyne_hyperdrive_test.transaction_probe (run_token, slot, value) VALUES ($1, 0, $2)', $token, $unicode);
    my $inside_hr=await $db_or->query('SELECT value FROM webdyne_hyperdrive_test.transaction_probe WHERE run_token=$1', $token);
    die "transaction read failed\n" unless $inside_hr->{'rows'}[0][0] eq $unicode;
    await $db_or->query('ROLLBACK');
    my $after_hr=await $db_or->query('SELECT count(*) FROM webdyne_hyperdrive_test.transaction_probe WHERE run_token=$1', $token);
    die "rollback failed\n" unless $after_hr->{'rows'}[0][0] eq '0';

    my $stale_fg=0;
    if ($db_or->{'previous'}) {
        my $old_or=bless({capability => $db_or->{'previous'}}, ref($db_or));
        my $ok_fg=eval { await $old_or->query('SELECT 1'); 1 };
        die "stale capability unexpectedly usable\n" if $ok_fg;
        die "unexpected stale capability error: $@" unless $@=~/expired prototype capability/;
        $stale_fg=1;
    }

    await $db_or->query('BEGIN');
    await $db_or->query('INSERT INTO webdyne_hyperdrive_test.transaction_probe (run_token, slot, value) VALUES ($1, 1, $2)', $token, 'lifecycle rollback');
    die "intentional prototype application failure\n" if $scope_hr->{'path'} eq '/fail';
    if ($scope_hr->{'path'} eq '/abort') {
        await $send_cr->({type => 'http.response.start', status => 200, headers => [['content-type', 'text/plain']]});
        await $send_cr->({type => 'http.response.body', body => $token, more => 1});
        await $db_or->query('SELECT pg_sleep(5)');
        await $send_cr->({type => 'http.response.body', body => 'complete'});
        return;
    }
    my $body=JSON::PP->new()->encode({typed => 1, fixture => 1, rollback => 1, stale => $stale_fg, token => $token});
    await $send_cr->({type => 'http.response.start', status => 200, headers => [['content-type', 'application/json']]});
    await $send_cr->({type => 'http.response.body', body => $body});
};
