{
  "name": "@webdyne/webdyne-cloudflare",
  "version": "1.1.0",
  "description": "Cloudflare service extensions for WebDyne running under WebAssembly",
  "type": "module",
  "files": [
    "js",
    "lib",
    "webdyne-extension.json"
  ],
  "exports": {
    ".": "./js/cloudflare.js",
    "./cloudflare": "./js/cloudflare.js",
    "./d1-host": "./js/d1-host.js",
    "./kv-host": "./js/kv-host.js",
    "./r2-host": "./js/r2-host.js",
    "./webdyne-extension.json": "./webdyne-extension.json"
  },
  "scripts": {
    "test": "npm run test:perl && npm run test:js",
    "test:perl": "prove -Ilib t",
    "test:js": "node --test test-js/*.test.mjs",
    "pack:check": "node tools/check-package.mjs",
    "smoke:d1": "node tools/smoke-d1.mjs",
    "smoke:kv": "node tools/smoke-kv.mjs",
    "smoke:r2": "node tools/smoke-r2.mjs"
  },
  "sideEffects": false,
  "keywords": [
    "webdyne",
    "cloudflare",
    "d1",
    "kv",
    "r2",
    "perl",
    "webassembly"
  ],
  "author": "Andrew Speer",
  "license": "Artistic-1.0-Perl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspeer/pm-WebDyne-Cloudflare.git"
  },
  "homepage": "https://github.com/aspeer/pm-WebDyne-Cloudflare#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
